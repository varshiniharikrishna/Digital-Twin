# Copy to .env only if you use a dotenv loader; never commit .env.
# The app currently reads these from the environment of the process that starts it.
DT_DATA_SOURCE=mysql
DT_MYSQL_USER=
DT_MYSQL_PASSWORD=
DT_MYSQL_HOST=localhost
DT_MYSQL_PORT=3306
DT_MYSQL_DB=DigitalTwinDB
DT_MODEL=XGBoost
DT_REAL_DATA_PATH=
DT_TARGET=composite_proxy
