# Copy this file to .env, fill in the MySQL values, and run ./run_app.command.
# .env is git-ignored and the launcher loads these values into the Flask process.
DT_DATA_SOURCE=mysql
DT_MYSQL_USER=
DT_MYSQL_PASSWORD=
DT_MYSQL_HOST=localhost
DT_MYSQL_PORT=3306
DT_MYSQL_DB=DigitalTwinDB
DT_MODEL=XGBoost
DT_REAL_DATA_PATH=
DT_TARGET=composite_proxy
